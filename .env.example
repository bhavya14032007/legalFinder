PORT=5000
# Optional MongoDB Connection String (falls back to resilient in-memory storage if not provided)
MONGODB_URI=mongodb://localhost:27017/legalfinder

# Optional GenAI API Keys (supports Google Gemini API or OpenAI API with automatic fallback)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Client URL for CORS
CLIENT_URL=http://localhost:5173
